# Backend API base URL (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase (browser-safe — anon key + URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Buyer-facing brand (manifest M4 — flows through config, never hardcoded).
# Brand decision is open per FIGHT_TRAINER.md §12 — these are placeholders.
NEXT_PUBLIC_BUYER_BRAND_NAME=Fight Trainer
NEXT_PUBLIC_BUYER_BRAND_TAGLINE=AI coaching infrastructure for combat sports
NEXT_PUBLIC_BUYER_BRAND_DOMAIN=fight-trainer.app
