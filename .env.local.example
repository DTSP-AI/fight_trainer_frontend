# Backend API base URL (FastAPI).
# Local dev: http://localhost:8010
# Production: set https://fight-trainer-backend.onrender.com on Vercel.
NEXT_PUBLIC_API_URL=http://localhost:8010

# Supabase — browser-safe modern API keys ONLY.
# Use the publishable key (sb_publishable_*). DO NOT use the legacy anon JWT
# (eyJhbGciOiJIUzI...) format — JWT verification across the stack is ES256/JWKS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Buyer-facing brand (M4 — flows through config, never hardcoded).
NEXT_PUBLIC_BUYER_BRAND_NAME=Fight Trainer
NEXT_PUBLIC_BUYER_BRAND_TAGLINE=Private coaching. Real progress.
NEXT_PUBLIC_BUYER_BRAND_DOMAIN=fight-trainer.app
